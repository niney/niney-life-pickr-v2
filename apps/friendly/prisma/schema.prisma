generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // 세션 무효화 카운터 — logout/비밀번호 변경 시 증가시켜 발급된 모든 JWT 를 무효화.
  // JWT 의 tv 클레임과 다르면 authenticate 가 401. 기본 0(기존 토큰은 tv 없음→0 취급).
  tokenVersion Int      @default(0)

  picks       Pick[]
  settlements SettlementSession[]
  contacts    SettlementContact[]
  drafts      SettlementDraft[]

  busFavoriteStations BusFavoriteStation[]
  busFavoriteRoutes   BusFavoriteRoute[]

  subwayFavoriteStations SubwayFavoriteStation[]
  subwayFavoriteLines    SubwayFavoriteLine[]

  restaurantFavorites RestaurantFavorite[]

  votes VoteSession[]

  airLocation              AirUserLocation?
  mealEntries              MealEntry[]
  mealPhotos               MealPhoto[]
  mealPreference           MealPreference?
  mealRecommendations      MealRecommendation[]
  mealRecommendationEvents MealRecommendationEvent[]
  mealDailyQuotas          MealDailyQuota[]
  mealDataImports          MealDataImport[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// 정산하기 — 한 번의 정산 세션. 차수(SettlementRound) 1개 이상으로 구성되며
// 각 차수는 서로 다른 식당일 수 있다. session 본체에 남는 restaurantPlaceId/
// restaurantName 은 '1차 식당' 스냅샷 — 목록 검색·이력 호환을 위해 중복 보유
// 한다 (rounds[0] 와 항상 동기화).
//
// 로그인 사용자 본인만 보고 편집할 수 있다 (개인 전용). 영수증 토큰·source·
// totalAmount 같은 차수 단위 정보는 모두 SettlementRound 로 이동했다.
model SettlementSession {
  id                String    @id @default(cuid())
  userId            String
  // 1차 식당의 placeId 스냅샷. rounds[0].restaurantPlaceId 와 동기화.
  restaurantPlaceId String
  // 1차 식당 이름 스냅샷.
  restaurantName    String
  // 모든 차수 itemsSubtotal 의 합. 클라이언트가 매번 계산하지 않아도 되도록 저장.
  grandTotal        Int
  // 공유 링크 토큰 — null 이면 비공개. POST /settlements/:id/share 로 owner 가
  // 생성/만료갱신, DELETE 로 회수. 토큰 자체는 추측 불가능한 7바이트 base64url(10자).
  // 만료(shareExpiresAt)가 항상 걸려 노출 창이 닫히므로 짧아도 안전.
  // unique 인덱스로 GET /share/settlements/:token 조회 O(1).
  shareToken        String?   @unique
  // 공유 링크 만료 시각 — 지나면 GET 공개 조회가 410. owner 가 다시 share 하면
  // ttl 기준으로 갱신(연장)된다. null = 만료 없음(구버전 토큰 호환).
  shareExpiresAt    DateTime?
  // 공유 미리보기(OG) 이미지 선택: 'restaurant'(식당 사진) | 'table'(정산표).
  // null = 미설정 → 기본 'restaurant'(식당 사진, 없으면 정산표로 폴백). 공유 시
  // owner 가 다이얼로그 토글로 정한다. share-preview 가 og:image 로 반영.
  shareOgImage      String?
  // 'restaurant' 모드에서 owner 가 갤러리에서 직접 고른 식당 사진의 원본 URL
  // (네이버 호스트). null = 미선택 → 토큰 시드로 결정적 랜덤 1장. 자동 랜덤이
  // 관련 없는 사진을 고르는 걸 피하려고 owner 가 특정 1장으로 고정할 수 있다.
  // 후보 목록에서 사라진 URL 은 share 시 정리(null 로) 된다.
  shareOgImageUrl   String?
  // 본문(참여자/차수/항목)이 저장 후 마지막으로 수정된 시각. 한 번도 수정 안
  // 했으면 null. updatedAt 과 분리한 이유: updatedAt 은 shareToken 발급/회수
  // 에도 갱신되어 '수정됨' 배지 기준으로 부적합.
  editedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds       SettlementRound[]
  participants SettlementParticipant[]

  @@index([userId, createdAt])
  @@index([restaurantPlaceId])
  @@map("settlement_sessions")
}

// 한 정산 안의 한 차수. 같은 식당의 영수증 여러 장이든 다른 식당으로 이동한
// 2차이든 동일하게 round 1행. 식당 정보·영수증·source·totalAmount 가 모두
// round 단위.
model SettlementRound {
  id                  String  @id @default(cuid())
  sessionId           String
  orderIndex          Int
  // 차수마다 다른 식당일 수 있으므로 round 단위 식당 snapshot.
  restaurantPlaceId   String
  restaurantName      String
  // 'MANUAL' | 'RECEIPT' — 차수마다 다를 수 있다 (1차 영수증, 2차 직접 입력 등).
  source              String
  totalAmount         Int?
  warning             String?
  // 영수증 이미지 토큰 — data/receipts/<token>.jpg. MANUAL 차수는 null.
  receiptImageToken   String?
  // 이 차수 items.amount 합 - discountAmount. session.grandTotal 의 부품.
  itemsSubtotal       Int
  // 차수 할인 — 영수증 쿠폰/멤버십 등. null 이면 할인 없음. 양수면 한
  // 카테고리(discountCategory) 풀에서만 차감. 풀 음수 차단은 zod refine.
  discountAmount      Int?
  discountCategory    String?
  // 분담 다듬기 — 카테고리별 잔여 처리 규칙을 JSON 으로 직렬화. 모양:
  // { [Category]: { leftoverParticipantIds: string[], roundUnit: number|null } }.
  // 수령자 1명=몰아주기, 여러 명=잔여 균등 분배. null/미설정이면 default(첫
  // 참여자 흡수). 레거시 단일 leftoverParticipantId 도 읽기 시 호환 처리.
  categoryAdjustments String?
  // 세부 분배 그룹(소주/맥주 잔수 등)을 JSON 배열로 직렬화. 모양:
  // [{ label, category, itemIndexes, mode: 'EQUAL'|'GLASSES',
  //    members: [{ participantId, glasses }] }]. null/미설정이면 없음.
  groupSplits         String?

  session   SettlementSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items     SettlementItem[]
  attendees SettlementRoundParticipant[]

  @@index([sessionId])
  @@map("settlement_rounds")
}

model SettlementItem {
  id              String  @id @default(cuid())
  roundId         String
  // 사용자가 화면에서 본 그대로의 메뉴명.
  name            String
  unitPrice       Int?
  // 직접 입력 모드에서 빠뜨릴 수 있어 nullable.
  quantity        Int?
  // 라인 합계. 분배 계산은 이 값으로 한다.
  amount          Int
  // 'ALCOHOL' | 'NON_ALCOHOL' | 'SIDE' | 'UNCATEGORIZED'.
  category        String
  // 레스토랑 등록 메뉴 이름과 매칭됐을 때 정규화된 표기.
  matchedMenuName String?
  orderIndex      Int

  round SettlementRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@map("settlement_items")
}

// 마스터 참여자 — session 직속. exclude* 는 'default' 의미, 차수 단위 override
// 는 SettlementRoundParticipant 에서. shareAmount 는 모든 차수 분담의 grand
// total (per person).
model SettlementParticipant {
  id                String  @id @default(cuid())
  sessionId         String
  // 이름·닉네임 둘 중 하나만 채워져도 valid — application layer 가 검증.
  name              String?
  nickname          String?
  // 마스터 default. 차수 단위 override 가 없을 때 사용된다.
  excludeAlcohol    Boolean @default(false)
  excludeNonAlcohol Boolean @default(false)
  excludeSide       Boolean @default(false)
  // 모든 차수의 분담 합 (grand total). items/excludes/attendees 가 바뀌면
  // 서버가 다시 계산해 update.
  shareAmount       Int
  orderIndex        Int
  // 같은 사용자의 단골(SettlementContact) 과 연결. 자동 적립 시 매번 채워지고,
  // 단골이 삭제되면 SetNull 로 끊고 정산 본체는 그대로 둔다(이력 보존).
  contactId         String?

  session      SettlementSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contact      SettlementContact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  roundEntries SettlementRoundParticipant[]

  @@index([sessionId])
  @@index([contactId])
  @@map("settlement_participants")
}

// 차수 × 참여자 join. attended=false 면 분담 = 0. excludeXxxOverride 가
// non-null 이면 마스터 default 를 무시하고 이 차수에서만 다른 값으로 친다.
// (예: 마스터에선 '술 X' 인데 이 차수에선 마심 → excludeAlcoholOverride=false)
model SettlementRoundParticipant {
  id                        String   @id @default(cuid())
  roundId                   String
  participantId             String
  attended                  Boolean  @default(true)
  excludeAlcoholOverride    Boolean?
  excludeNonAlcoholOverride Boolean?
  excludeSideOverride       Boolean?
  // 이 차수에서의 분담액. 비참석이면 0.
  shareAmount               Int

  round       SettlementRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant SettlementParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId])
  @@index([roundId])
  @@index([participantId])
  @@map("settlement_round_participants")
}

// 사용자별 "단골 참여자" 메모. 새 정산을 만들 때마다 모든 participant 가
// (userId, normalizedKey) 기준 upsert 된다 — 같은 사람을 매번 다시 입력하지
// 않고 자동완성으로 고르게 한다. lastExclude* 는 가장 최근 정산에서의 선택을
// 다음 정산의 default 로 제안하는 데 사용.
//
// normalizedKey = lower(trim(name)) + "|" + lower(trim(nickname)). 같은 사용자
// 안에서 unique — 정확 일치 자동완성 매칭의 키. 사용자가 직접 같은 이름을
// 타이핑해도 이 키로 기존 row 와 매칭된다.
model SettlementContact {
  id                    String   @id @default(cuid())
  userId                String
  // 표시용 — 정산을 만들 때 사용자가 입력한 마지막 표기 그대로 보존.
  name                  String?
  nickname              String?
  // 매칭/유니크 키. application layer 에서 정규화 함수가 채움. 직접 SQL 로
  // 만들 일이 없도록 service 에 전담.
  normalizedKey         String
  // 가장 최근 정산에서의 카테고리별 exclude 값. 다음 정산의 default 제안.
  lastExcludeAlcohol    Boolean  @default(false)
  lastExcludeNonAlcohol Boolean  @default(false)
  lastExcludeSide       Boolean  @default(false)
  // 등장 횟수. 자동완성 정렬·UI 노출 우선순위 후보. 현재는 표시만.
  useCount              Int      @default(1)
  // 자동완성 정렬용 (가장 최근에 쓴 사람을 위로).
  lastUsedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants SettlementParticipant[]

  @@unique([userId, normalizedKey])
  @@index([userId, lastUsedAt])
  @@map("settlement_contacts")
}

// 정산 입력 화면의 서버 임시저장. 자동저장(debounce)으로 다기기 동기화 목적.
// 사용자가 완성된 정산을 저장(SettlementSession 생성)하면 매칭 draft 는
// 자동 삭제된다.
//
// placeIdKey: '1차 식당으로 진입' 슬롯과 '/me/settlements/new' 슬롯을
// 분리하기 위한 unique 키. 후자는 빈 문자열 '' 로 둔다 (SQLite 의 NULL
// unique 가 다중 NULL 을 허용하기 때문에 sentinel 사용).
//
// payload: settlementDraftStore 상태(JSON 직렬화) 그대로. 서버는 스키마
// 검증을 하지 않고 보관만 한다 — 클라이언트 버전 진화에 유연하게.
model SettlementDraft {
  id            String   @id @default(cuid())
  userId        String
  placeIdKey    String   @default("")
  payload       String
  // 1차 식당 이름 캐시 — 이력 페이지 "이어 입력" 행 라벨용. 매번 payload 를
  // 파싱하지 않고도 표시 가능.
  placeNameHint String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeIdKey])
  @@index([userId, updatedAt])
  @@map("settlement_drafts")
}

model Pick {
  id        String   @id @default(cuid())
  userId    String
  title     String
  options   String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  results PickResult[]

  @@index([userId])
  @@map("picks")
}

model PickResult {
  id       String   @id @default(cuid())
  pickId   String
  chosen   String
  pickedAt DateTime @default(now())

  pick Pick @relation(fields: [pickId], references: [id], onDelete: Cascade)

  @@index([pickId])
  @@map("pick_results")
}

// 외부 지도 서비스 키. 현재는 vworld JS API 키만 사용하지만, 카카오/네이버
// 지도가 추가될 가능성을 열어두기 위해 LlmProviderConfig 와 같은 형태로
// provider 컬럼에 식별자(예: 'vworld')를 둔다. apiKey 는 admin 화면이 평문
// 으로 다시 받아와야 하기 때문에 (vworld JS SDK는 init 시 키를 그대로 URL
// 에 붙여 호출) AI 키와 달리 reveal 엔드포인트를 따로 둔다.
model MapProviderConfig {
  id          String   @id @default(cuid())
  provider    String   @unique
  apiKey      String
  // vworld는 키 발급 시 도메인 화이트리스트가 필수. 운영/로컬이 다르면
  // 키를 따로 둬야 하므로 여기는 단순 메모용. 콤마 구분 자유 입력.
  domains     String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("map_provider_configs")
}

// purpose 컬럼은 같은 provider 를 용도별로 따로 등록할 수 있게 한다 — 텍스트
// 추론(chat)과 비전(image)이 보통 다른 모델이라 한 row 로 묶기 어렵다.
// 마이그레이션 시점에 기존 행은 모두 purpose='chat' 으로 채워진다.
model LlmProviderConfig {
  id            String   @id @default(cuid())
  provider      String
  purpose       String   @default("chat")
  apiKey        String
  baseUrl       String?
  defaultModel  String?
  enabled       Boolean  @default(true)
  maxConcurrent Int      @default(15)
  updatedAt     DateTime @updatedAt
  updatedById   String?

  @@unique([provider, purpose])
  @@map("llm_provider_configs")
}

// 출처 가로지르는 "같은 가게" 의 정체. Restaurant(N) → CanonicalRestaurant(1).
// 어드민이 Naver+다이닝코드 두 행을 같은 가게로 인식하면 두 Restaurant 가
// 같은 canonicalId 를 공유한다. 마이그레이션 직후엔 1:1 (각 Restaurant 가 자기
// 전용 Canonical 보유) 상태로 시작하고, merge API 호출로 점차 통합된다.
model CanonicalRestaurant {
  id                    String    @id @default(cuid())
  // 표시용 가게명. merge 시 primary(보통 Naver) 행 이름 채택.
  name                  String
  // 대표 카테고리 (primary 행).
  primaryCategory       String?
  // 후보 매칭용 위경도 — 보통 primary 행과 동일. merge 시 primary 좌표 유지.
  latitude              Float?
  longitude             Float?
  // 빠른 후보 검색용 정규화 키 (normalizeName + 좌표 round). matching 유틸
  // 에서 채운다. 인덱스로 prefix scan.
  searchKey             String?
  // 어드민이 "이 가게는 다른 출처와 합칠게 없어" 라고 닫은 시각. 한 번 닫으면
  // list 응답의 suggestion 이 더 이상 노출되지 않는다. null 이면 노출 후보.
  // 새 등록 시점에 자동 산출되는 1차 제안에 한정 — 사용자가 직접 "병합" 패널을
  // 열면 별도 후보 API 가 풀 후보를 다시 계산한다.
  suggestionDismissedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  restaurants Restaurant[]
  proposalsA  CanonicalMergeProposal[] @relation("ProposalCanonicalA")
  proposalsB  CanonicalMergeProposal[] @relation("ProposalCanonicalB")

  @@index([searchKey])
  @@index([latitude, longitude])
  @@map("canonical_restaurants")
}

// 자동 매칭이 두 canonical 을 "같은 가게일 수 있다" 고 잡았을 때 큐에 적재되는
// 검토 대기 항목. 정책상 자동 머지는 하지 않고 모두 사람이 확인 — score 가
// 임계(0.45) 이상이면 무조건 여기로 들어온다.
//
// 중복 방지를 위해 양방향 쌍을 정규화: 항상 canonicalAId < canonicalBId
// (cuid 문자열 사전순) 으로 저장. unique 제약으로 동일 쌍이 한 번만 큐에 뜬다.
//
// status 흐름:
//   open       — 어드민 검토 대기. UI 노출 대상.
//   accepted   — 어드민이 수락 → CanonicalService.merge 실행 → A/B 한쪽 소멸.
//   rejected   — 어드민이 "같은 가게 아님" 거절. 같은 쌍이 다시 제안되지 않음.
//   superseded — 다른 머지로 둘 중 한 canonical 이 사라짐(=stale). UI 에서 숨김.
model CanonicalMergeProposal {
  id           String    @id @default(cuid())
  canonicalAId String
  canonicalBId String
  score        Float
  nameScore    Float
  // 둘 다 좌표 있을 때만 채워짐. null 이면 이름 단독 매칭.
  distanceM    Float?
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  canonicalA CanonicalRestaurant @relation("ProposalCanonicalA", fields: [canonicalAId], references: [id], onDelete: Cascade)
  canonicalB CanonicalRestaurant @relation("ProposalCanonicalB", fields: [canonicalBId], references: [id], onDelete: Cascade)

  @@unique([canonicalAId, canonicalBId])
  @@index([status])
  @@map("canonical_merge_proposals")
}

model Restaurant {
  id             String   @id @default(cuid())
  // 외부 소스 식별자. source='naver'면 placeId 와 같은 값이 sourceId 에도 들어가고,
  // diningcode/catchtable 은 placeId 가 null. 공개 /restaurants/:placeId 라우트 호환을
  // 깨지 않으려 placeId 는 nullable 컬럼으로 남겨두되 신규 소스에서는 채우지 않는다.
  source         String   @default("naver")
  sourceId       String
  placeId        String?  @unique
  // 같은 가게의 다른 출처 행과 묶는 키. 마이그레이션 직후엔 모든 행이 자기
  // 전용 Canonical 을 가지고 (1:1), merge API 로 점차 N:1 이 된다. NOT NULL.
  canonicalId    String
  name           String
  category       String?
  address        String?
  phone          String?
  rating         Float?
  reviewCount    Int?
  rawSourceUrl   String
  snapshotJson   String
  firstCrawledAt DateTime @default(now())
  lastCrawledAt  DateTime @updatedAt

  canonical      CanonicalRestaurant   @relation(fields: [canonicalId], references: [id])
  visitorReviews VisitorReview[]
  menuCanonicals MenuCanonical[]
  menuGroups     RestaurantMenuGroup[]
  sourceMenus    RestaurantMenu[]
  reviewClusters ReviewCluster[]

  @@unique([source, sourceId])
  @@index([source])
  @@index([canonicalId])
  @@map("restaurants")
}

// 크롤 소스에서 읽은 원본 메뉴 그룹. 공개 응답의 기존 flat `menus` 는 계속
// snapshotJson 에서 제공하고, 이 테이블은 원본 그룹/정렬/출처를 손실 없이
// 보존해 재가공·비교·관리 화면에서 쓸 수 있게 한다.
model RestaurantMenuGroup {
  id            String   @id @default(cuid())
  restaurantId  String
  source        String
  sourceGroupId String?
  name          String
  sortOrder     Int
  rawJson       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menus      RestaurantMenu[]

  @@unique([restaurantId, source, sourceGroupId])
  @@index([restaurantId, source, sortOrder])
  @@map("restaurant_menu_groups")
}

// 크롤 소스에서 읽은 원본 메뉴. 같은 메뉴가 "대표메뉴"와 실제 카테고리에
// 동시에 노출될 수 있어 sourceMenuId 는 unique 로 묶지 않는다.
model RestaurantMenu {
  id               String   @id @default(cuid())
  restaurantId     String
  groupId          String?
  source           String
  sourceMenuId     String?
  name             String
  price            String?
  description      String?
  imageUrlsJson    String   @default("[]")
  isRepresentative Boolean  @default(false)
  sortOrder        Int
  rawJson          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  group      RestaurantMenuGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([restaurantId, source, sortOrder])
  @@index([groupId, sortOrder])
  @@index([restaurantId, source, sourceMenuId])
  @@map("restaurant_menus")
}

// 식당 내 메뉴 표기 변형을 canonical 그룹으로 매핑하는 테이블.
// nameNorm = MenuMention.nameNorm 과 동일한 정규화 (소문자+공백/특수문자 제거).
// 한 식당 안에서 (nameNorm) → (canonicalName) 으로 묶고, canonicalNorm 은
// 통계 GROUP BY 키. version 은 MENU_GROUPING_VERSION — 프롬프트/모델 변경
// 시 stale 매핑 식별용.
model MenuCanonical {
  id            String   @id @default(cuid())
  restaurantId  String
  nameNorm      String
  canonicalName String
  canonicalNorm String
  version       Int      @default(1)
  model         String?
  createdAt     DateTime @default(now())

  restaurant Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  globalLink GlobalMenuCanonicalLink?

  @@unique([restaurantId, nameNorm])
  @@index([restaurantId, canonicalNorm])
  @@map("menu_canonicals")
}

// 식당 가로지르는 전역 canonical — 모든 식당의 MenuCanonical 그룹들을 다시
// LLM 으로 묶어 만든 단일 진실. 글로벌 메뉴 통계의 GROUP BY 키.
// version 변경 시 이전 매핑 stale.
model GlobalMenuCanonical {
  id           String   @id @default(cuid())
  // 표시용 표기 — 전역 대표 이름 (예: "김치찌개").
  displayName  String
  // 그룹 키 (displayName 의 normalizeTerm). 통계 쿼리의 GROUP BY 키.
  globalKey    String   @unique
  // 계층 카테고리 path (예: "한식 > 찌개 > 김치찌개"). null = 분류 없음.
  // 마지막 segment 는 displayName 과 같거나 약간 더 일반적인 표기. 통계 쿼리는
  // 항상 globalKey 로 GROUP BY 하고 categoryPath 는 표시·prefix 필터용.
  categoryPath String?
  version      Int      @default(1)
  model        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links GlobalMenuCanonicalLink[]

  @@index([categoryPath])
  @@map("global_menu_canonicals")
}

// 식당별 MenuCanonical → 전역 GlobalMenuCanonical 다대일 링크.
// (restaurantId, localCanonicalNorm) 가 유니크 — 한 식당의 한 그룹은
// 정확히 한 전역 그룹에만 속한다.
model GlobalMenuCanonicalLink {
  id                 String @id @default(cuid())
  // MenuCanonical row 의 id 와 1:1 — onDelete: Cascade 로 동기화.
  menuCanonicalId    String @unique
  // 빠른 조회용 비정규화 (restaurantId + localCanonicalNorm). MenuCanonical
  // 을 매번 조인하지 않아도 글로벌 키로 곧장 통계 가능.
  restaurantId       String
  localCanonicalNorm String
  globalCanonicalId  String

  menuCanonical MenuCanonical       @relation(fields: [menuCanonicalId], references: [id], onDelete: Cascade)
  global        GlobalMenuCanonical @relation(fields: [globalCanonicalId], references: [id], onDelete: Cascade)

  @@index([globalCanonicalId])
  @@index([restaurantId])
  @@map("global_menu_canonical_links")
}

// 머지 청크 LLM 결과 메모이즈 — 같은 청크(입력 표기 배열, 순서 그대로)를 다시
// 묻지 않는다. cacheKey = sha256(model | schemaHash | variants). schemaHash 가
// 프롬프트·버전·카테고리 화이트리스트·샘플링 파라미터를 묶으므로, 그중 하나라도
// 바뀌면 키가 달라져 옛 캐시는 자연 미스(무효화). 성공 응답만 저장 — 실패 청크는
// 남기지 않아 다음 머지가 재시도하게 한다. 전량 머지여도 변하지 않은 청크는
// 히트로 LLM 을 건너뛴다(정확도는 동일, 같은 답 재사용).
model GlobalMergeChunkCache {
  id           String   @id @default(cuid())
  cacheKey     String   @unique
  mappingsJson String
  model        String
  schemaHash   String
  createdAt    DateTime @default(now())

  @@index([schemaHash])
  @@map("global_merge_chunk_cache")
}

model VisitorReview {
  id            String   @id @default(cuid())
  restaurantId  String
  externalId    String?
  authorName    String?
  rating        Int?
  body          String
  visitedAt     String?
  imageUrlsJson String
  videosJson    String   @default("[]")
  contentHash   String
  fetchedAt     DateTime @default(now())

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  summary    ReviewSummary?

  @@unique([restaurantId, externalId])
  @@unique([restaurantId, contentHash])
  @@index([restaurantId])
  @@map("visitor_reviews")
}

model ReviewSummary {
  id                String    @id @default(cuid())
  reviewId          String    @unique
  status            String
  text              String?
  model             String?
  errorCode         String?
  errorMessage      String?
  // 구조화된 분석 — LLM이 JSON으로 한 번에 추출.
  // sentiment: positive | negative | neutral | mixed
  sentiment         String?
  // -1.0 ~ 1.0
  sentimentScore    Float?
  // 1~5
  satisfactionScore Int?
  // [{ name, sentiment }] 직렬화
  menusJson         String?
  // string[] 직렬화 (예: "주차 협소", "예약 필수")
  tipsJson          String?
  // string[] 직렬화 — 분위기/서비스/가격 등 자유 태그
  keywordsJson      String?
  // 프롬프트/모델 변경 시 재분석 트리거용
  analysisVersion   Int?
  // ── review-search(문맥검색/RAG) enrichment ─────────────────────────────
  // bge-m3 임베딩(float[1024]) JSON 직렬화 — 인앱 코사인용.
  embeddingJson     String?
  // 관점→극성 {맛:"neg", 주차:"pos", ...} 직렬화 (구조 필터/검색).
  aspectsJson       String?
  // Contextual Retrieval 한 줄 — 임베딩 입력에 prepend(짧은 리뷰 recall↑).
  contextLine       String?
  // 위 enrichment 의 버전(프롬프트/모델 변경 시 재생성 트리거).
  enrichVersion     Int?
  // ── review-clustering(비슷한 문맥 리뷰 군집화) 멤버십 ──────────────────────
  // 배치로 재계산 시 함께 갱신. null = 노이즈/미분류("기타"). 군집 행 삭제 시 SetNull.
  clusterId         String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  review       VisitorReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  menuMentions MenuMention[]
  tags         ReviewTag[]
  cluster      ReviewCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([clusterId])
  @@map("review_summaries")
}

// 한 식당 리뷰를 "비슷한 문맥"끼리 묶은 군집(토픽). 저장된 bge-m3 임베딩으로
// UMAP→HDBSCAN→c-TF-IDF(Python 배치) 후 LLM 한 줄 라벨을 붙여 영속한다.
// 식당 단위로 통째 재계산(delete+insert) — clusterVersion 으로 재계산 게이트.
// 멤버십은 ReviewSummary.clusterId. 노이즈 리뷰는 어느 군집에도 속하지 않음(null).
model ReviewCluster {
  id               String   @id @default(cuid())
  restaurantId     String
  ordinal          Int // 표시 순서 — size 내림차순.
  label            String // LLM 한 줄 라벨 (예: "웨이팅이 긴 편")
  tone             String // positive | negative | mixed | neutral
  size             Int // 멤버 리뷰 수 = 카운트
  keywordsJson     String // c-TF-IDF 상위 키워드 string[] 직렬화
  repReviewIdsJson String // 대표 리뷰 id[] 직렬화 (읽기 시 body join)
  aspectsJson      String // 집계 관점→극성 카운트 직렬화 (부가 라벨)
  clusterVersion   Int // = CLUSTERING_VERSION (알고리즘/프롬프트 변경 시 ↑)
  // 군집 시점의 검색가능(임베딩) 리뷰 수. 자동 재군집 게이트용 — 다음 크롤 때
  // 현재 수와 비교해 충분히 늘었을 때만 재군집(비용·churn 방지). 같은 식당 행 동일값.
  corpusSize       Int      @default(0)
  createdAt        DateTime @default(now())

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  members    ReviewSummary[]

  @@index([restaurantId])
  @@map("review_clusters")
}

// 분석 done 시 menusJson 을 행 단위로 풀어 쓴 테이블. 글로벌·필터·검색
// 통계용. summaryId 단위로 한 번에 다시 써(delete + insert) 재분석/백필
// 결과와 자연스럽게 동기화된다.
model MenuMention {
  id           String @id @default(cuid())
  summaryId    String
  restaurantId String
  // 원문 표기. UI 노출 시 사용.
  name         String
  // 그룹키 — 소문자 + 공백 제거. 동의어 사전은 추후 도입.
  nameNorm     String
  // positive | negative | neutral. v3 잔존 행에서 null 들어온 경우 'neutral'
  // 로 정규화해 저장한다(통계 쿼리에서 분기 줄임).
  sentiment    String
  // 메뉴 traits 원본 (string[] 직렬화). 빈도 집계가 필요해지면 별도 테이블로
  // 분리하지만, 지금은 응답 라운드트립용으로만 보존.
  traitsJson   String @default("[]")

  summary ReviewSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([nameNorm])
  @@index([restaurantId, nameNorm])
  @@index([summaryId])
  @@map("menu_mentions")
}

// 크롤+요약 잡의 단계별 로그. 어드민 UI 가 진행 상황·끊김 지점을 사후에도
// 추적할 수 있게 영속화. SSE 의 실시간 이벤트와 동일한 데이터를 DB 에도
// 저장해, 잡 종료 후 패널 재진입 시에도 같은 로그를 볼 수 있다.
//
// stage 는 CrawlStage 가 아니라 자유 문자열. 요약 파이프라인의 단계
// ('summary_queue', 'summary_attempt' 등) 까지 같은 테이블에 누적한다.
// meta 는 모델·지연ms·토큰·attempt 등 디버깅용 부가 정보의 JSON 직렬화.
model CrawlJobLog {
  id        String   @id @default(cuid())
  jobId     String
  placeId   String?
  stage     String
  level     String
  message   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([placeId, createdAt])
  @@map("crawl_job_logs")
}

// 범용 작업 실행(run) 헤더 — 크롤/요약/정규화/정산 추출 등 모든 기능의 실행
// 1회를 한 행으로 남긴다. CrawlJobLog 가 크롤+요약 전용이었던 것을 일반화한
// 후속 테이블. jobId/subjectId 는 기능별 의미가 달라(크롤 jobId, placeId,
// 'dc:<vRid>' 등) 자유 문자열로 둔다. 레거시 백필 행은 id 가 'legacy-<jobId>'.
model OperationRun {
  id           String    @id @default(cuid())
  // 8종: 'crawl'|'summary'|'menu-grouping'|'settlement-extraction'|
  // 'auto-discover'|'schedule'|'global-merge'|'diningcode-bulk-save'
  feature      String
  // 인메모리 레지스트리 잡 ID (crawl jobId, ScheduleRun.id 등). 레지스트리가
  // 없는 동기 실행(정산 추출 등)은 null.
  jobId        String?
  // placeId / restaurantId / 'dc:<vRid>' 등 — 대상 식별자.
  subjectId    String?
  // 중첩 run 연계 (schedule→menu-grouping 등). 부모 run 의 id.
  parentRunId  String?
  // 'running'|'done'|'failed'|'cancelled'. 재시작 고아는 부팅 sweep 이
  // 'failed'(errorCode='server_restart') 로 마감한다.
  status       String    @default("running")
  // 'manual'|'cron'|'auto'|'user' 등 — 기능별 어휘 상이.
  trigger      String?
  errorCode    String?
  // 2000자 캡 — application layer 에서 절단.
  errorMessage String?
  // JSON 직렬화, 4096자 캡. cacheHit/skipped 등 실행 부가 정보.
  meta         String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  logs   OperationLog[]
  report OperationReport?

  @@index([feature, startedAt])
  @@index([status, startedAt])
  @@index([jobId])
  @@index([startedAt])
  @@map("operation_runs")
}

// run 의 스텝 단위 로그. feature/jobId/subjectId 는 run 에도 있지만 비정규화
// 해 둔다 — 레거시 크롤 로그 조회(jobId/placeId 기준)가 조인 없이 이 테이블만
// 으로 동작해야 하기 때문.
model OperationLog {
  id        String   @id @default(cuid())
  runId     String
  // 비정규화 — run.feature 와 동일.
  feature   String
  // 비정규화 — 레거시 크롤 로그 조회 호환용 (CrawlJobLogEntry.jobId non-null).
  jobId     String?
  // 비정규화 — placeId 기준 레거시 조회 유지용.
  subjectId String?
  stage     String
  // 'debug'|'info'|'warn'|'error'. debug 는 DB+pino 전용 (SSE 미발송).
  level     String
  // 2000자 캡.
  message   String
  // JSON 직렬화, 4096자 캡.
  meta      String?
  createdAt DateTime @default(now())

  run OperationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([feature, createdAt])
  @@index([subjectId, createdAt])
  // 레거시 잡 로그 조회(jobId 기준)가 풀스캔하지 않도록.
  @@index([jobId, createdAt])
  @@index([createdAt])
  @@map("operation_logs")
}

// 실패 run 1건당 LLM 분석 보고서 1개 (runId unique). done 보고서만 보존
// 정리에서 제외되는 영구 기록(run 헤더+보고서만 남고 스텝 로그는 소멸) —
// 본문 없는 미완(pending/running/failed) 보고서는 보존 기간이 지나면 run 과
// 함께 정리된다.
model OperationReport {
  id               String   @id @default(cuid())
  runId            String   @unique
  // 'pending'|'running'|'done'|'failed'. failed 는 수동 '다시 분석' 으로 복구.
  status           String   @default("pending")
  provider         String?
  model            String?
  // 1-2문장 요약.
  summary          String?
  rootCause        String?
  // markdown 본문.
  details          String?
  // string[] JSON 직렬화 — 서버가 파싱해 배열로 응답.
  suggestions      String?
  // 'low'|'medium'|'high' — LLM JSON schema enum 으로 강제.
  severity         String?
  errorCode        String?
  errorMessage     String?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  run OperationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("operation_reports")
}

// 로그 보존 설정 — 전역 단일 행(key='global'). ScheduleConfig 처럼 키 컬럼
// unique 로 upsert 하는 소형 설정 테이블.
model LogConfig {
  id            String   @id @default(cuid())
  key           String   @unique @default("global")
  // 보존 기간(일). cutoff 이전 로그/보고서 없는 run 을 매일 정리.
  retentionDays Int      @default(30)
  updatedAt     DateTime @updatedAt

  @@map("log_configs")
}

// tip + keyword 를 한 테이블에 통합. kind 로 구분 — 둘 다 free-form 짧은
// 한국어 태그라 스키마가 같다. 별도 테이블로 쪼개면 조회 쿼리만 두 번 나서
// 캐시 키도 늘어난다.
model ReviewTag {
  id           String @id @default(cuid())
  summaryId    String
  restaurantId String
  // 'tip' | 'keyword'
  kind         String
  term         String
  termNorm     String

  summary ReviewSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([kind, termNorm])
  @@index([restaurantId, kind])
  @@index([summaryId])
  @@map("review_tags")
}

// 주기 자동 실행 설정 — 관리자가 cron 으로 "정규화 → 글로벌 머지" 파이프라인을
// 예약. jobType 당 한 행(현재는 'normalize-merge' 단일). 부팅 시 이 행을 읽어
// 인프로세스 스케줄러(croner)에 등록하고, 어드민이 바꾸면 런타임 재등록한다.
// 단일 인스턴스라 분산 락은 불필요 — CLAUDE.md 의 no-Redis 전제와 일관.
model ScheduleConfig {
  id         String    @id @default(cuid())
  // 작업 종류 — 행 식별 키. 현재는 'normalize-merge' 하나.
  jobType    String    @unique
  enabled    Boolean   @default(false)
  // cron 식 (5필드). 예: '0 3 * * *' = 매일 03:00. 검증은 croner 가 한다.
  cronExpr   String
  // IANA 타임존. 기본 Asia/Seoul.
  timezone   String    @default("Asia/Seoul")
  // 마지막 실행 시각/결과 — 빠른 표시용 비정규화. 상세 이력은 ScheduleRun.
  // nextRunAt 은 저장하지 않는다 — croner 로 매번 계산(저장하면 stale).
  lastRunAt  DateTime?
  lastStatus String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("schedule_configs")
}

// 주기 작업 한 번의 실행 기록 — 이력 조회/감사용. status='running' 으로 시작해
// done/failed/interrupted 로 마감한다. skipped 는 이전 실행이 아직 안 끝나
// 이번 tick 을 건너뛴(overlap 방지) 경우를 한 행으로 남긴다.
model ScheduleRun {
  id             String    @id @default(cuid())
  jobType        String
  // 'cron' | 'manual'
  trigger        String
  // 'running' | 'done' | 'failed' | 'skipped' | 'interrupted'
  status         String
  // collecting 단계 후 확정된 처리 대상 식당 수. 미정 시 null.
  totalTargets   Int?
  // 정규화(grouping) 완료 식당 수.
  processedCount Int       @default(0)
  // 크롤 진행 중이라 이번 실행에서 제외한 식당 수.
  skippedCount   Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([jobType, startedAt])
  @@map("schedule_runs")
}

// 맛집 자동 발굴 설정 — cron 으로 지역을 (랜덤/고정) 골라 검색 → 후보를
// 텔레그램으로 보내고 사용자가 고른 가게만 크롤. schedule_configs 와 같은
// 형태지만 지역/검색 설정이 추가된다. 텔레그램 토큰은 env 에 두고 여기 저장
// 안 한다(설정 화면에 노출 금지).
model RandomCrawlConfig {
  id                 String    @id @default(cuid())
  // 'random-crawl' 고정. 행 식별 키.
  jobType            String    @unique
  enabled            Boolean   @default(false)
  cronExpr           String    @default("0 11 * * *")
  timezone           String    @default("Asia/Seoul")
  // RandomCrawlRegion 직렬화 JSON (시/구/동 + 랜덤 플래그).
  regionJson         String    @default("{}")
  // 검색 키워드 — 동 이름과 결합. 기본 "맛집".
  keyword            String    @default("맛집")
  // 텔레그램으로 보낼 후보 수.
  candidateCount     Int       @default(5)
  // 무응답 시 회차를 닫기까지 대기할 분. (앱 기본값은 30 — DEFAULT_TIMEOUT_MIN.
  // DB default 는 실사용 안 됨: updateConfig 가 항상 값을 지정하고 getConfig 는
  // 행 없을 때 앱 상수로 폴백. 컬럼 default 변경은 SQLite 테이블 재생성을 유발해
  // 일부러 180 유지.)
  responseTimeoutMin Int       @default(180)
  // 무응답 시 동작 — "skip"(건너뛰기) | "random"(랜덤 자동 크롤).
  timeoutAction      String    @default("skip")
  lastRunAt          DateTime?
  lastStatus         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("random_crawl_configs")
}

// 자동 발굴 한 회차. running → awaiting_selection(텔레그램 응답 대기) →
// crawling → done. 무응답/후보0/overlap 은 skipped, 오류는 failed, 재시작
// 고아는 interrupted. 텔레그램 콜백이 chatId+messageId 로 이 행을 찾아 선택을
// 반영하므로 두 값을 영속한다(메모리만으로는 재시작에 약함).
model RandomCrawlRun {
  id                  String    @id @default(cuid())
  // 'cron' | 'manual'
  trigger             String
  // running|awaiting_selection|crawling|done|skipped|failed|interrupted
  status              String
  // 선정된 지역 표시용. 예: "서울특별시 강남구 역삼동".
  regionLabel         String?
  keyword             String?
  // RandomCrawlCandidate[] 직렬화 JSON.
  candidatesJson      String    @default("[]")
  selectedPlaceId     String?
  crawledRestaurantId String?
  // 텔레그램 응답 매칭용 — 후보를 보낸 메시지.
  telegramChatId      String?
  telegramMessageId   String?
  // awaiting_selection 만료 시각 — 지난 회차는 sweep 이 skipped 로 닫는다.
  expiresAt           DateTime?
  error               String?
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?

  @@index([status])
  @@index([startedAt])
  @@map("random_crawl_runs")
}

// 텔레그램 봇 설정 — 단일 행(key 고정). LlmProviderConfig/MapProviderConfig 와
// 같은 "DB 우선 + .env fallback" 패턴. DB 행이 있으면 그 값을 쓰고, 없으면
// env(TELEGRAM_*)로 폴백한다. 어드민 "설정 > 텔레그램"에서 관리.
model TelegramConfig {
  id          String   @id @default(cuid())
  // 단일 행 보장용 고정 키.
  key         String   @unique @default("telegram")
  botToken    String   @default("")
  chatId      String   @default("")
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("telegram_configs")
}

// 서울시 버스 정류소 — 정류소 마스터(load:bus-stations, busStopLocationXyInfo
// 전량)가 기본 공급원이고 getStationByName 검색 캐시도 upsert 한다.
// PK 는 stId(9자리 고유 ID) — 가상정류장은 arsId='0' 이 여럿이라 arsId 는
// PK/unique 불가. 좌표는 WGS84 로 정규화한 값만 저장.
model BusStation {
  stId      String   @id
  arsId     String
  name      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchHits BusStationSearchHit[]

  @@index([arsId])
  @@map("bus_stations")
}

// 정류소 마스터 적재 이력 — 주변 정류장 미적재 판별 + fetchedAt(마스터 기준일)
// 산출용. 지하철 SubwayMasterSync 와 동일 패턴.
model BusMasterSync {
  id       Int      @id @default(autoincrement())
  source   String // 'busStopLocationXyInfo'
  count    Int
  loadedAt DateTime @default(now())

  @@map("bus_master_syncs")
}

// 키워드 검색 캐시 헤더 — fetchedAt 이 TTL(30일) 안이면 서울시 API 재호출 없이
// hits 로 응답. 빈 결과도 행을 남긴다(네거티브 캐싱 — 무의미 키워드의 반복
// 업스트림 호출 방지). keyword 는 trim + NFC 정규화 후 저장.
model BusStationSearch {
  id        String   @id @default(cuid())
  keyword   String   @unique
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hits BusStationSearchHit[]

  @@map("bus_station_searches")
}

// 검색 ↔ 정류소 조인. rank 로 서울시 API 응답 순서를 보존한다.
model BusStationSearchHit {
  searchId String
  stId     String
  rank     Int

  search  BusStationSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  station BusStation       @relation(fields: [stId], references: [stId], onDelete: Cascade)

  @@id([searchId, stId])
  @@map("bus_station_search_hits")
}

// 로그인 사용자의 버스 정류장 즐겨찾기. 저장 시점 정류장 스냅샷(name/lat/lng)을
// 그대로 보존해 목록 렌더·지도 이동에 재조회가 필요 없다(정류소는 사실상 정적).
// 캐시 테이블 BusStation 을 참조하지 않는다 — 그건 전 정류장 마스터가 아니라
// 검색/주변 조회로 우연히 캐시된 부분집합이라 FK 로 묶으면 캐시 정리가 즐겨찾기를
// 깨뜨린다. (userId, stId) 유니크로 사용자당 한 정류장 1행(upsert 멱등).
model BusFavoriteStation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stId      String
  arsId     String
  name      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@unique([userId, stId])
  @@index([userId])
  @@map("bus_favorite_stations")
}

// 정류장×노선 조합 즐겨찾기 — 특정 정류장에서 특정 노선의 도착정보로 재진입하기
// 위한 스냅샷. routeName/stationName/arsId/lat/lng 를 저장 시점 그대로 보존한다.
// (userId, stId, busRouteId) 유니크.
model BusFavoriteRoute {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stId        String
  busRouteId  String
  routeName   String
  stationName String
  arsId       String
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())

  @@unique([userId, stId, busRouteId])
  @@index([userId])
  @@map("bus_favorite_routes")
}

// 그룹 투표 픽 — 방장이 맛집 후보로 만든 투표방. 토큰은 생성 시 즉시 발급
// (링크가 곧 투표방, 정산 공유와 동일한 7바이트 base64url) + 7일 고정 TTL.
// 마감 결과(winnerOptionId/decidedBy)는 마감 시 확정 저장 — 동점 티브레이크가
// 랜덤이라 조회 시 재계산할 수 없다.
model VoteSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  shareToken     String    @unique
  shareExpiresAt DateTime
  closedAt       DateTime?
  winnerOptionId String?
  // 'votes'(단독 최다) | 'smart-pick'(동점 → AI 가중) | 'random'(동점 → 균등)
  decidedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  options VoteOption[]
  ballots VoteBallot[]

  @@index([userId, createdAt])
  @@map("vote_sessions")
}

// 투표 후보 — 등록 맛집의 저장 시점 스냅샷(즐겨찾기 계약의 축소판, 클라 제공).
// Restaurant 마스터와 FK 로 묶지 않는다(삭제/재크롤에도 투표방 생존).
model VoteOption {
  id           String      @id @default(cuid())
  sessionId    String
  session      VoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderIndex   Int
  placeId      String
  name         String
  category     String?
  thumbnailUrl String?

  ballots VoteBallot[]

  @@index([sessionId])
  @@map("vote_options")
}

// 찬성 1건 — approval 투표라 (후보, 투표자) 단위 1행. voterKey 는 클라 영속
// UUID(기기 단위 식별, 완벽하지 않음 수용), voterLabel 은 표시 이름 스냅샷.
model VoteBallot {
  id         String      @id @default(cuid())
  sessionId  String
  session    VoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  optionId   String
  option     VoteOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterKey   String
  voterLabel String
  createdAt  DateTime    @default(now())

  @@unique([optionId, voterKey])
  @@index([sessionId, voterKey])
  @@map("vote_ballots")
}

// 로그인 사용자의 맛집 즐겨찾기 — 저장 시점 스냅샷(name/category/address/썸네일/
// 좌표)을 보존한다(BusFavoriteStation 과 동일 설계). Restaurant 마스터와 FK 로
// 묶지 않는다 — 어드민 삭제/재크롤이 즐겨찾기를 깨뜨리지 않게. 좌표는 식당
// 마스터가 nullable 이라 스냅샷도 nullable. (userId, placeId) 유니크(upsert 멱등).
model RestaurantFavorite {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId      String
  name         String
  category     String?
  address      String?
  thumbnailUrl String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  @@unique([userId, placeId])
  @@index([userId])
  @@map("restaurant_favorites")
}

// 노선 상세(형상+경유 정류소+기본정보) 합본 캐시 — busRouteInfo 3콜(getRoutePath/
// getStaionByRoute/getRouteInfo)을 한 번에 수집해 정규화한 JSON blob 을 노선
// 단위로 보존한다. 형상·정류소·기본정보는 사실상 정적이라 TTL 30일(검색 캐시와
// 동일). 노선 단위 원자 조회라 정규화 테이블 없이 payload 한 컬럼에 담는다.
model BusRouteShape {
  busRouteId String   @id
  // 정규화된 { info, path, stations } JSON 직렬화.
  payload    String
  fetchedAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("bus_route_shapes")
}

// 수도권 전철 역사마스터 — openapi subwayStationMaster(784행)를 전량 적재해
// 로컬 검색한다(업스트림 쿼터 0). 버스와 달리 캐시가 아니라 마스터 테이블:
// load:subway-stations 스크립트가 채우고 검색은 여기만 읽는다.
//
// PK 설계(플랜 B): 역사마스터의 BLDN_ID(4자리)는 실시간 API 의 statnId(10자리)와
// 불일치해 조인 키로 못 쓴다. 내부 id 는 `${lineId}:${name}` 합성이며, 실시간
// 조회(2차~)는 역명 기반이라 이 설계로 완결된다. 같은 물리 역이라도 호선마다
// 마스터 행(좌표 포함)이 따로 있다 — (lineId, name) 유니크.
model SubwayStation {
  id           String   @id // `${lineId}:${name}` 합성 — 플랜 B
  name         String // BLDN_NM ('강남')
  realtimeName String? // 실시간 API 조회 역명이 다를 때만 ('서울역'→'서울')
  lineId       String // 실시간 subwayId 체계 ('1002')
  lineName     String // SUBWAY_LINES.name 표기
  statnId      String? // 실시간 10자리 — 추후 관측 backfill
  stationCd    String? // 4자리 역코드(BLDN_ID) — 8차 시간표 조인 후보
  frCode       String? // 외부코드 — 5차 정렬 후보 (마스터엔 없음, 추후)
  lat          Float
  lng          Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([lineId, name])
  @@index([name])
  @@index([lineId])
  @@map("subway_stations")
}

// 역사마스터 적재 이력 — 검색 응답의 fetchedAt(마스터 기준일) 산출용.
model SubwayMasterSync {
  id       Int      @id @default(autoincrement())
  source   String // 'subwayStationMaster'
  count    Int
  loadedAt DateTime @default(now())

  @@map("subway_master_syncs")
}

// 노선별 역 운행 순서(5차 호선 보기). load-subway-line-orders 가 openapi
// SearchSTNBySubwayLineInfo 의 FR_CODE 순서로 적재한다(본선/지선 section 분리,
// seq 1부터 연속). stationId 는 SubwayStation.id 를 참조하되 FK 는 없다 —
// 마스터/순서 재적재가 서로를 깨지 않도록(스냅샷 내성). 순환/지선명은 적재
// 데이터로 정해진다. isLoop 는 DB 컬럼 대신 서비스 상수(LOOP_SECTIONS).
model SubwayLineStation {
  id         Int     @id @default(autoincrement())
  lineId     String
  branchKey  String  @default("main") // 'main' | 지선 슬러그('seongsu' 등)
  branchName String? // 표시명 — 본선 null, 지선 '성수지선' 등
  seq        Int // section 내 운행 순서 (1부터 연속)
  stationId  String // SubwayStation.id (`${lineId}:${name}`) — FK 없음(재적재 내성)

  @@unique([lineId, branchKey, seq])
  @@index([lineId])
  @@map("subway_line_stations")
}

// section 실형상(OSM 선로 기하) — load-subway-shapes 가 적재. SubwayLineStation
// 의 (lineId, branchKey) section 과 1:1. stationS 는 section stations seq 순서와
// 정렬된 형상 호길이(m) — 재적재로 역 수가 어긋나면 서비스가 부착을 생략한다.
model SubwayLineShape {
  id            Int      @id @default(autoincrement())
  lineId        String
  branchKey     String   @default("main")
  path          String // [ [lat,lng], ... ] JSON — 순환(isLoop)은 닫힌 링(첫점=끝점)
  stationS      String // number[] JSON — stations[i]의 형상 호길이(m), seq asc
  osmRelationId String? // 출처 OSM relation id — 재적재/디버깅 추적
  loadedAt      DateTime @default(now())

  @@unique([lineId, branchKey])
  @@map("subway_line_shapes")
}

// 역×호선 시간표 blob 캐시(8차) — 서울시 SearchSTNTimeTableByIDService(1~9호선)를
// (stationId, dayType) 단위로 30일 캐싱한다. 시간표는 사실상 정적이고 방향별
// 2콜이라 원자 조회(정규화 { coverage, directions } JSON 한 컬럼). coverage:false
// (광역·경전철, 또는 1~9호선인데 데이터 0)도 캐싱해 무의미 재호출을 막는다.
model SubwayTimetableCache {
  cacheKey  String   @id // `${stationId}|${dayType}`
  payload   String // 정규화 { coverage, directions } JSON 직렬화
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subway_timetable_caches")
}

// 시간대별 혼잡도(10차) — 서울교통공사 1~8호선 정적 통계(odcloud 파일데이터,
// 분기 갱신). load-subway-congestion 이 wide(39슬롯)→slots JSON 으로 전량 적재한다.
// (호선, 출발역, dayType, 상하구분) 단위 1행. stationId 는 우리 SubwayStation.id
// 조인 성공 시만(역번호↔stationCd + 역명 폴백) — 실시간이 아니라 FK 없이 스냅샷.
model SubwayCongestion {
  id          Int      @id @default(autoincrement())
  stationId   String? // 조인 성공 시 SubwayStation.id (미조인 null)
  lineId      String // '1001'~'1008'
  stationName String // 원본 출발역명('서울역')
  dayType     String // '1' 평일 / '2' 토 / '3' 휴일(일요일)
  updn        String // 원문 '상선'/'하선'/'내선'/'외선'
  slots       String // [{time:'HH:MM', level:number|null}] JSON (39개, time 순)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([lineId, stationName, dayType, updn])
  @@index([stationId])
  @@map("subway_congestions")
}

// 로그인 사용자의 지하철 역 즐겨찾기(그룹 단위). 저장 시점 스냅샷(name/lat/lng/
// lines)을 그대로 보존해 목록 렌더·지도 이동에 재조회가 필요 없다. 버스 즐겨찾기와
// 동일하게 SubwayStation(캐시가 아닌 마스터지만) 을 FK 로 묶지 않는다 — 스냅샷이라
// 마스터 보정·삭제가 즐겨찾기를 깨뜨리지 않게 한다. (userId, stationId) 유니크.
model SubwayFavoriteStation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 검색 그룹 대표 id `${lineId}:${name}` 스냅샷.
  stationId String
  name      String
  // 그룹 lineId 목록(오름차순)을 콤마 결합한 문자열 — SQLite 라 배열 컬럼이 없어
  // 서비스 경계에서 join/split 한다(계약은 string[]).
  lines     String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@unique([userId, stationId])
  @@index([userId])
  @@map("subway_favorite_stations")
}

// 역×호선 즐겨찾기 — 도착 패널의 호선 섹션에서 추가. stationName/lat/lng 를
// 저장 시점 그대로 보존한다. (userId, stationId, lineId) 유니크.
model SubwayFavoriteLine {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId   String
  lineId      String
  stationName String
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())

  @@unique([userId, stationId, lineId])
  @@index([userId])
  @@map("subway_favorite_lines")
}

// 내 대기 위치 — 사용자가 지정·저장한 좌표 1곳(상단바 대기 칩이 이 좌표로 가장 가까운
// 측정소의 현재 등급을 보여준다). 로그인 사용자의 서버 저장분이며 게스트는 클라이언트
// persist. 한 사용자당 1행(userId PK) — PUT 은 덮어쓰기. 해석(가까운 측정소)은 저장하지
// 않고 조회 시 계산한다(측정소 신설·폐지에 자동 대응).
model AirUserLocation {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  // 표시용 라벨(저장 시점의 가까운 측정소명 등) — 선택.
  label     String?
  // 'geolocation' | 'manual' — 계약(AirLocationSource)이 검증, SQLite 라 문자열.
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("air_user_locations")
}

// ── 일상지도(전국 CCTV·공중화장실) ────────────────────────────────────────────
// 지방행정인허가데이터개방(localdata.go.kr) 전국 CSV 를 load:life-cctv / load:life-toilets 가
// 전량 교체 적재한다(관리번호 PK, FK 없음 — 재적재 내성). 조회는 지도 뷰포트 bbox 가 전부라
// (lat,lng) 복합 인덱스가 핵심이고, 저줌은 같은 인덱스 위에서 GROUP BY 집계한다.
model LifeCctv {
  // 관리번호(전국 유일 — 실측 중복 0).
  id          String  @id
  // 개방자치단체코드(7자리) — 관리 주체 식별.
  orgCode     String
  orgName     String
  roadAddr    String?
  lotAddr     String?
  // 설치목적구분 — @repo/utils LIFE_CCTV_PURPOSES 10종으로 정규화.
  purpose     String
  cameraCount Int?
  // 카메라화소수(만 화소).
  pixels      Int?
  direction   String?
  keepDays    Int?
  // 설치연월 'YYYYMM'.
  installedYm String?
  phone       String?
  lat         Float
  lng         Float
  // 데이터기준일자 'YYYY-MM-DD'.
  baseDate    String

  @@index([lat, lng])
  @@map("life_cctvs")
}

// 공중화장실 — 원본 CSV 에 좌표가 없어(표준데이터도 2025-02 부터 좌표 제외) 주소를 VWorld
// 지오코더로 변환한 lat/lng 를 든다. 실패 건은 null(지도 미표시) — geoSource 가 출처.
model LifeToilet {
  id                   String   @id
  orgCode              String
  name                 String
  // 구분명(공중/개방/간이/이동/기타).
  kind                 String
  roadAddr             String?
  lotAddr              String?
  orgName              String
  phone                String?
  // 개방시간 구분(상시/정시/불규칙/미개방/미상) + 상세 원문 + 24시간 판정(적재 시 계산).
  openType             String
  openDetail           String?
  open24               Boolean
  maleToilet           Int      @default(0)
  maleUrinal           Int      @default(0)
  maleDisabledToilet   Int      @default(0)
  maleDisabledUrinal   Int      @default(0)
  maleKidsToilet       Int      @default(0)
  maleKidsUrinal       Int      @default(0)
  femaleToilet         Int      @default(0)
  femaleDisabledToilet Int      @default(0)
  femaleKidsToilet     Int      @default(0)
  // 장애인용/어린이용 변기 1개 이상 — 필터용 파생 불리언.
  disabled             Boolean
  kids                 Boolean
  ownerType            String
  disposal             String?
  safetyTarget         Boolean?
  bell                 Boolean
  bellPlace            String?
  entranceCctv         Boolean
  diaper               Boolean
  diaperPlace          String?
  installedYm          String?
  remodeledYm          String?
  baseDate             String
  lat                  Float?
  lng                  Float?
  // 'road' | 'parcel' — 어느 주소로 맞췄는지. null = 좌표 없음.
  geoSource            String?

  @@index([lat, lng])
  @@map("life_toilets")
}

// 병의원 — 심평원 병원정보서비스 API(data.go.kr 15001698) 전량 적재. 좌표(XPos/YPos)는 업스트림
// 제공이 원칙이고, 없는 소수 기관만 주소 지오코딩으로 보완(geoSource 가 출처) — 그래도 실패면
// null(지도 미표시).
model LifeHospital {
  // 암호화 요양기호(ykiho).
  id          String  @id
  name        String
  // 종별코드명 원문(상급종합병원~조산원).
  kindName    String
  // 필터용 정규화 종별 — @repo/utils LIFE_HOSPITAL_CATEGORIES 7종.
  category    String
  sidoName    String?
  sgguName    String?
  emdongName  String?
  postNo      String?
  addr        String?
  phone       String?
  url         String?
  // 개설일자 'YYYY-MM-DD'.
  openedDate  String?
  // 총의사수 — 업스트림 미제공이면 null.
  doctorCount Int?
  lat         Float?
  lng         Float?
  // 'api' | 'road' | 'parcel' — 좌표 출처. null = 좌표 없음.
  geoSource   String?

  @@index([lat, lng])
  @@map("life_hospitals")
}

// 주소 → 좌표 지오코딩 캐시 — VWorld 지오코더 응답을 (type,address) 키로 영구 보관해 재적재
// 때 업스트림 호출을 0 에 가깝게 만든다. notfound 도 기록(반복 호출 방지) — 재시도는 플래그로.
model LifeGeocodeCache {
  // 'road' | 'parcel'
  type      String
  address   String
  // 'ok' | 'notfound'
  status    String
  lat       Float?
  lng       Float?
  // 지오코더가 정제해 돌려준 주소(표시·검증용).
  refined   String?
  checkedAt DateTime @default(now())

  @@id([type, address])
  @@map("life_geocode_caches")
}

// 적재 이력 — 레이어별 최신 행이 "적재됨" 판정·fetchedAt·상태 API 의 원천(버스/지하철
// MasterSync 와 같은 패턴). geocoded 는 화장실의 좌표 확보 건수.
model LifeMasterSync {
  id         Int      @id @default(autoincrement())
  // 'cctv' | 'toilet' | 'hospital'
  layer      String
  count      Int
  geocoded   Int?
  // 적재 파일의 데이터기준일자 최댓값 'YYYY-MM-DD'.
  baseDate   String?
  sourceFile String?
  loadedAt   DateTime @default(now())

  @@index([layer, loadedAt])
  @@map("life_master_syncs")
}

// ── 음식 카탈로그(food) — 식단 관리(meal) 마스터 데이터. docs/PLAN-meal.md ──────────────
// 행 식별 키는 nameNorm(normalizeTerm) — 출처가 달라도 같은 이름이면 한 행(적재가 병합:
// 비어 있는 필드 채움 + 별칭·sourceRefs 추가 + popularity 누적). 사용자 식단 기록(MealItem)은
// 이 행을 FK 없이 스냅샷(foodId 문자열)으로 가리킨다 — 재적재·삭제에 안전.
model FoodItem {
  id                   String   @id @default(cuid())
  name                 String
  // normalizeTerm(name) — 매칭/중복 키.
  nameNorm             String   @unique
  // 대표식품명(표준데이터 foodLv4Nm) — 변형 축약 키.
  repName              String?
  // 별칭 표시 문자열 JSON 배열 / 별칭 정규화(normalizeTerm) JSON 배열(LIKE 검색용).
  aliasesJson          String   @default("[]")
  aliasNormsJson       String   @default("[]")
  // 2축 분류 + 요리 계통 — 값 집합은 @repo/api-contract FoodDishType/FoodMainIngredient/FoodCuisine.
  dishType             String?
  mainIngredient       String?
  cuisine              String?
  // 주요 재료 JSON 배열(레시피 DB). 없으면 null.
  ingredientsJson      String?
  // 구조화 알레르겐 best-effort 메타와 근거. 빈 배열은 안전 보장이 아니라 "알려진 항목 없음"이다.
  allergensJson        String   @default("[]")
  allergenEvidenceJson String   @default("[]")
  // unknown|inferred|verified. inferred는 재료 문자열 규칙, verified는 운영자 검수.
  allergenStatus       String   @default("unknown")
  // 1인분 중량(g/ml) + 1인분 영양(표준데이터 100g 기준 × servingG/100 으로 환산).
  servingG             Float?
  kcal                 Float?
  carbG                Float?
  proteinG             Float?
  fatG                 Float?
  sodiumMg             Float?
  sugarG               Float?
  // 100g(또는 100ml)당 열량 — 표준데이터 원본 단위. 1인분 중량(servingG)이 없어 kcal 을
  // 환산하지 못한 행도 이 값은 가질 수 있다. 메뉴명에 중량이 있는 외식 메뉴("항정살 150g")의
  // "100g당" 표시 근거.
  kcalPer100g          Float?
  // 영양을 같은 계열 행에서 빌려왔으면 그 행의 이름(예: 불고기 ← '소불고기'). 직접 값이면 null.
  // UI 는 이 값이 있으면 "○○ 기준 추정"이라고 밝힌다.
  nutritionFrom        String?
  // 대표 출처('mfds-nutrition'|'mfds-recipe'|'mafra-recipe'|'hansik-800'|'menu-canonical'|'manual') + 그 id.
  source               String
  sourceId             String?
  // 원본 분류명(식품대분류 / RCP_PAT2 / 800선 카테고리 / categoryPath).
  sourceCategory       String?
  // 병합된 다른 출처 참조 JSON 배열 [{source, sourceId}].
  sourceRefsJson       String   @default("[]")
  // 외식 등장 식당 수 등 — 후보 풀·자동완성 가중.
  popularity           Int      @default(0)
  active               Boolean  @default(true)
  // LLM 2축 분류 버전/모델(매핑 테이블로만 채운 행은 null).
  classifyVersion      Int?
  classifyModel        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sourceObservations FoodSourceObservation[]
  mergeConflicts     FoodMergeConflict[]

  @@index([source, sourceId])
  @@index([dishType, mainIngredient])
  @@index([allergenStatus, active])
  @@index([active, popularity])
  @@map("food_items")
}

// 적재에서 관찰한 필드별 원본. 대표 FoodItem 값과 달라도 버리지 않고 충돌 검토 근거로 남긴다.
model FoodSourceObservation {
  id         String   @id @default(cuid())
  foodItemId String
  field      String
  valueJson  String
  source     String
  sourceId   String?
  observedAt DateTime @default(now())

  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([foodItemId, field])
  @@index([source, sourceId])
  @@map("food_source_observations")
}

// 기존 비어 있지 않은 값과 새 원본이 다를 때 운영자가 확인할 검토 큐.
model FoodMergeConflict {
  id                String    @id @default(cuid())
  foodItemId        String
  field             String
  existingValueJson String
  incomingValueJson String
  source            String
  sourceId          String?
  // open|kept_existing|accepted_incoming|dismissed
  status            String    @default("open")
  resolutionJson    String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([foodItemId, field])
  @@map("food_merge_conflicts")
}

// 적재 잡 설정 — random-crawl 과 같은 "jobType 1행" 모델. cron 기본은 매월 1일 04:00
// (표준데이터가 매월 초 병합 갱신).
model FoodImportConfig {
  id          String    @id @default(cuid())
  // 'food-import' 고정.
  jobType     String    @unique
  enabled     Boolean   @default(false)
  cronExpr    String    @default("0 4 1 * *")
  timezone    String    @default("Asia/Seoul")
  // FoodImportSource[] 직렬화 JSON.
  sourcesJson String    @default("[\"mfds-nutrition\",\"mfds-recipe\",\"mafra-recipe\",\"menu-canonical\"]")
  // 적재 후 미분류 행 LLM 2축 분류 수행 여부.
  classify    Boolean   @default(true)
  lastRunAt   DateTime?
  lastStatus  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("food_import_configs")
}

// 메뉴명 → 카탈로그 LLM 매칭 캐시(어휘 단위). 규칙 매칭(menu-nutrition.ts)이 못 잡은 메뉴명을
// 한 번만 묻고 결과를 영구 보관한다 — 부정 결과(foodId null)도 저장해 다시 묻지 않는다.
// foodId 는 FK 없음(카탈로그 재적재에 안전). version < MENU_LLM_MATCH_VERSION 이면 stale.
// 메뉴 칼로리 판정 엔진 어휘 — 코드 기본 어휘(engine/lexicon.ts) 위에 어드민이 얹는 항목.
// kind: modifier|size|synonym|set|option|suffix_block|raw_suffix|quantifier|alias. 값(칼로리)은 없다.
model MenuLexicon {
  id        String   @id @default(cuid())
  kind      String
  term      String
  // synonym 의 짝, alias 의 카탈로그 음식명. 그 외 null.
  target    String?
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, term, target])
  @@index([active])
  @@map("menu_lexicon")
}

model MenuLlmMatch {
  id         String   @id @default(cuid())
  // normalizeTerm(menuName) — 같은 표기는 식당이 달라도 답이 같다.
  nameNorm   String   @unique
  menuName   String
  foodId     String?
  foodName   String?
  // 모델 원문(감사·재판정용): 자유형 표준명 / 후보 선택 / 신뢰도 / 근거.
  canonical  String?
  choice     String?
  confidence String?
  reason     String?
  model      String
  version    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([foodId])
  @@index([version])
  @@map("menu_llm_matches")
}

// 카탈로그에 없는 음식의 웹 실측 추정(fatsecret.kr 검색 결과 집계) — 어휘 단위 캐시.
// kcalPer100g null = 조회했지만 채택 조건 미달(다시 묻지 않음, version 올리면 재조회).
model FoodWebEstimate {
  id          String   @id @default(cuid())
  nameNorm    String   @unique
  name        String
  kcalPer100g Float?
  // 채택 근거 항목 수와 방식('multi' 중앙값 | 'single' 일반 항목). 미채택이면 0 / null.
  agreeing    Int      @default(0)
  basis       String?
  // 항목 원문 JSON 배열(WebEstimateSample[]) — 감사·재집계용.
  samplesJson String   @default("[]")
  source      String
  sourceUrl   String
  version     Int
  fetchedAt   DateTime @default(now())

  @@index([version])
  @@map("food_web_estimates")
}

model FoodImportRun {
  id              String    @id @default(cuid())
  // 'cron' | 'manual'
  trigger         String
  // running|done|failed|skipped|interrupted
  status          String
  // 이번 회차 소스 목록 JSON / 소스별 집계(FoodImportSourceStat[]) JSON.
  sourcesJson     String    @default("[]")
  statsJson       String    @default("[]")
  classifiedCount Int       @default(0)
  error           String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([status])
  @@index([startedAt])
  @@map("food_import_runs")
}

// ── 식단 관리(meal) — 사용자 개인 기록. docs/PLAN-meal.md ──────────────────────────────
// 카탈로그(FoodItem)·식당(Restaurant)에 FK 를 걸지 않는다: 카탈로그는 재적재로 갈리고
// 식당은 재크롤/삭제된다. 필요한 값(foodId·분류·placeId·placeName)은 확정 시점 스냅샷.
model MealEntry {
  id                     String    @id @default(cuid())
  userId                 String
  // UTC. 정렬·표시용.
  eatenAt                DateTime
  // 'YYYY-MM-DD' 사용자 로컬 날짜 — 달력·통계 그룹 키(시간대 경계 오표시 방지).
  eatenDate              String
  // breakfast|lunch|dinner|snack|late_night
  slot                   String
  // home|dining_out|delivery|convenience|other
  mealType               String?
  placeId                String?
  placeName              String?
  memo                   String?
  // photo|manual|recommendation
  source                 String    @default("manual")
  // 추천에서 시작한 기록의 원본 id 스냅샷(FK 아님 — 추천 이력 정리 뒤에도 출처를 보존).
  originRecommendationId String?
  // 인식 원본 JSON {model, version, dishes[]} — 확정 후에도 보존(품질 측정).
  recognitionJson        String?
  // 사진만 정리한 기록은 텍스트를 유지하면서 그 사실을 명시한다.
  photoPurgedAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  MealItem[]
  photos MealPhoto[]

  @@index([userId, eatenAt])
  @@index([userId, eatenDate])
  @@index([userId, originRecommendationId])
  @@map("meal_entries")
}

model MealItem {
  id                    String  @id @default(cuid())
  entryId               String
  name                  String
  // normalizeTerm(name) — 빈도·겹침 통계의 그룹 키(카탈로그 매칭 실패해도 묶인다).
  nameNorm              String
  // FoodItem.id 스냅샷(FK 아님).
  foodId                String?
  dishType              String?
  mainIngredient        String?
  cuisine               String?
  // small|normal|large
  portion               String?
  // 사용자가 직접 입력한 인분 수. 자동 질량 추정은 저장하지 않는다.
  servings              Float?
  // vision_ordinal|user_serving
  portionSource         String?
  // false = 반찬·곁들임.
  isMain                Boolean @default(true)
  confidence            Float?
  // 원본 recognitionJson.dishes[].recognitionDishId 와 안정적으로 연결.
  recognitionDishId     String?
  selectedCandidateRank Int?
  // food_id|normalized_name|alias|none
  catalogMatchedBy      String?
  catalogMatchScore     Float?
  // recognized|manual|catalog|recommendation
  source                String  @default("manual")
  sortOrder             Int     @default(0)
  // 저장 시점 영양 스냅샷(1인분 × portion 배수). 카탈로그에 값이 없으면 null.
  kcal                  Float?
  proteinG              Float?
  sodiumMg              Float?
  // 영양을 같은 계열 음식에서 빌려온 경우 그 출처 문구(FoodItem.nutritionFrom 스냅샷).
  nutritionFrom         String?
  // direct|donor_estimate|missing
  nutritionBasis        String  @default("missing")

  entry MealEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([nameNorm])
  @@map("meal_items")
}

model MealPhoto {
  id        String   @id @default(cuid())
  // 서버 발급 uuid — data/meal-photos/<userId>/<token>.jpg 와 썸네일 <token>_t.jpg.
  token     String   @unique
  entryId   String?
  // 업로드 직후엔 기록이 없다(확정 전) — 소유 검증·고아 정리를 위해 사용자를 직접 들고 있다.
  userId    String
  width     Int?
  height    Int?
  byteSize  Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  entry MealEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
  @@index([userId, createdAt])
  @@map("meal_photos")
}

// 사용자당 1행(AirUserLocation 과 같은 PUT 덮어쓰기 모델).
model MealPreference {
  userId            String   @id
  // MealWeights JSON — 추천 점수 함수의 가중치.
  weightsJson       String
  excludedFoodsJson String   @default("[]")
  allergensJson     String   @default("[]")
  dislikedFoodsJson String   @default("[]")
  likedFoodsJson    String   @default("[]")
  mealTypesJson     String   @default("[]")
  slotsJson         String   @default("[\"breakfast\",\"lunch\",\"dinner\"]")
  onboarded         Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meal_preferences")
}

model MealRecommendation {
  id            String   @id @default(cuid())
  userId        String
  targetDate    String
  targetSlot    String
  // 요청 컨텍스트 {mealType, note, weather…} JSON.
  contextJson   String   @default("{}")
  // LLM 에 준 프로필 스냅샷 JSON — 재현·디버깅용(원시 기록은 넣지 않는다).
  profileJson   String   @default("{}")
  // MealRecommendationItem[] JSON.
  itemsJson     String   @default("[]")
  summary       String   @default("")
  notice        String?
  // done|fallback|failed
  status        String
  model         String?
  promptVersion Int      @default(1)
  // 같은 날·끼니·프로필이면 캐시 재사용 — 프로필+컨텍스트 해시.
  profileHash   String   @default("")
  feedbackJson  String?
  createdAt     DateTime @default(now())

  user   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  events MealRecommendationEvent[]

  @@index([userId, createdAt])
  @@index([userId, targetDate, targetSlot])
  @@map("meal_recommendations")
}

model MealRecommendationEvent {
  id               String   @id @default(cuid())
  recommendationId String
  userId           String
  // shown|candidate_picked|set_rated|candidate_rated|restaurant_opened|logged|dismissed
  kind             String
  candidateName    String?
  candidateFoodId  String?
  candidateRank    Int?
  rating           Int?
  // mobile|web|server
  platform         String
  rankingVersion   Int
  createdAt        DateTime @default(now())

  recommendation MealRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recommendationId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@map("meal_recommendation_events")
}

// 재시작에도 유지되는 일일 비용 한도. 같은 사용자/날짜/목적을 SQLite transaction 안에서 갱신한다.
model MealDailyQuota {
  userId    String
  date      String
  purpose   String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date, purpose])
  @@index([date, purpose])
  @@map("meal_daily_quotas")
}

// 같은 휴대용 백업을 여러 번 선택해도 데이터를 중복 생성하지 않게 하는 사용자별 원장.
// archiveId는 백업 생성 시 서버가 발급한 UUID이며 복원 트랜잭션과 함께 커밋된다.
model MealDataImport {
  id                   String   @id @default(cuid())
  userId               String
  archiveId            String
  entries              Int
  items                Int
  photos               Int
  recommendations      Int
  recommendationEvents Int
  preferenceResult     String
  importedAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, archiveId])
  @@index([userId, importedAt])
  @@map("meal_data_imports")
}

// DB에서 사진 소유 행을 지운 뒤 파일 unlink가 실패해도 토큰을 잃지 않게 하는 durable outbox.
// User FK를 일부러 걸지 않는다. 계정 삭제와 경합해도 cron이 사용자 폴더의 파일을 끝까지 지워야 한다.
model MealPhotoDeletion {
  id        String   @id @default(cuid())
  userId    String
  token     String
  reason    String
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId, attempts, createdAt])
  @@index([attempts, createdAt])
  @@map("meal_photo_deletions")
}

// ── 집값(/housing) — 아파트 실거래가 + 단지 마스터 ─────────────────────────────
// 단지 마스터: 한국부동산원 공동주택 단지 식별정보 CSV(source='reb', id=단지고유번호) + 실거래 주소로만
// 확인된 단지(source='rtms', id='rt:<sggCd>:<umd>:<jibun>:<정규화명>'). 좌표는 지번 주소를 VWorld 로
// 지오코딩(LifeGeocodeCache 공유). 1차는 kind='apt' 만 적재.
model HousingComplex {
  id           String  @id
  // 'reb' | 'rtms'
  source       String
  // 필지고유번호 19자리(reb 만).
  pnu          String?
  name         String
  // 다른 이름들('|' 구분 — 공시가격명·건축물대장명·도로명주소명·변경 이력) 검색·매칭용.
  altNames     String?
  // 'apt' | 'row' | 'multi'
  kind         String
  // 지번 주소 원문.
  addr         String
  sido         String
  sgg          String
  umd          String
  // 지번('56-45', '산1-8').
  jibun        String?
  // 법정동 시군구 5자리(실거래 LAWD_CD) / 법정동 10자리.
  sggCd        String
  bjdCd        String?
  dongCount    Int?
  households   Int?
  // 사용승인일 'YYYY-MM-DD'.
  approvedDate String?
  lat          Float?
  lng          Float?
  // 'road' | 'parcel' | null.
  geoSource    String?
  // 단지 마스터 CSV 기준일(rtms 단지는 생성일).
  baseDate     String
  // ── 보강(선택) ── K-apt 관리비 공개 의무단지(load:housing-kapt): 단지코드·분양형태(분양|임대|혼합)·난방·승강기.
  kaptCode     String?
  saleType     String?
  heating      String?
  elevatorCount Int?
  // 건축HUB 건축물대장 총괄표제부/표제부(load:housing-buildings): 주차·최고층·구조·도로명주소 + 조회 시각(장부).
  roadAddr     String?
  parkingCount Int?
  floorsMax    Int?
  structure    String?
  buildingFetchedAt DateTime?

  @@index([lat, lng])
  @@index([sggCd, umd, jibun])
  @@index([kind, households])
  @@map("housing_complexes")
}

// 실거래 한 건 — (sggCd, dealYm, dealType) 파티션 단위로 전량 교체(신고 지연·해제 반영). id 는 자연키
// 해시(같은 파티션 안 완전 중복은 '#n' 접미). complexId 는 매칭된 단지(없으면 rtms 단지를 만들어 채움).
model HousingTrade {
  id           String  @id
  complexId    String?
  sggCd        String
  // 계약년월 'YYYYMM' / 계약일 'YYYY-MM-DD'.
  dealYm       String
  dealDate     String
  // 'trade' | 'jeonse' | 'monthly'
  dealType     String
  umdNm        String
  jibun        String?
  aptNm        String
  // 실거래 단지일련번호('11110-31') — 매매 상세만.
  aptSeq       String?
  roadNm       String?
  // 전용면적(㎡).
  area         Float
  floor        Int?
  buildYear    Int?
  // 매매가 / 전세·월세 보증금(만원). rent 는 월세(만원, 그 외 0).
  price        Int
  rent         Int     @default(0)
  dealingGbn   String?
  canceled     Boolean @default(false)
  canceledDate String?
  rgstDate     String?
  aptDong      String?
  buyerGbn     String?
  slerGbn      String?
  contractType String?
  useRRRight   String?
  contractTerm String?
  preDeposit   Int?
  preRent      Int?
  landLease    Boolean @default(false)

  @@index([complexId, dealType, dealDate])
  @@index([sggCd, dealYm, dealType])
  @@map("housing_trades")
}

// 단지 × 거래 유형 × 면적 구간('all' 포함) 통계 — 적재 뒤 rebuild 로 전량 재계산. 지도 배지·주변 목록·
// 상세 통계가 이 표만 읽는다(요청 경로에서 거래 표를 집계하지 않는다).
model HousingComplexStat {
  complexId   String
  dealType    String
  band        String
  latestPrice Int
  latestRent  Int
  latestArea  Float
  latestFloor Int?
  latestDate  String
  count12     Int
  count       Int
  // 최근 12개월 평균 단위가(만원/㎡).
  unitPrice12 Float?
  // dealType='any'·band='all' 폴백 행에서만 — 그 최근 거래가 어느 유형인지(trade|jeonse|monthly).
  latestDealType String?

  @@id([complexId, dealType, band])
  @@map("housing_complex_stats")
}

// 파티션 적재 장부 — 어느 (시군구, 계약년월, 유형)을 언제 몇 건 받았는지. 증분 적재·재수집 판단 기준.
model HousingTradeSync {
  sggCd     String
  dealYm    String
  dealType  String
  count     Int
  fetchedAt DateTime @default(now())

  @@id([sggCd, dealYm, dealType])
  @@index([dealType, dealYm])
  @@map("housing_trade_syncs")
}

// 실행 이력 — 'complex'(단지 마스터 교체) | 'trade'·'rent'(실거래 적재 실행) | 'stats'(통계 재계산).
model HousingSync {
  id         Int      @id @default(autoincrement())
  kind       String
  count      Int
  geocoded   Int?
  baseDate   String?
  sourceFile String?
  loadedAt   DateTime @default(now())

  @@index([kind, loadedAt])
  @@map("housing_syncs")
}

// 공동주택 공시가격(국토교통부 주택 공시가격 정보 파일, 호별 1,558만 행)을 단지 × 면적 구간으로 접은 표 —
// load:housing-prices 가 PNU 로 단지에 직결해 전량 교체. 거래가 없는 단지에도 가격 앵커를 준다.
model HousingComplexPrice {
  complexId String
  // 'all' | 'b1' … 'b4'
  band      String
  // 공시 기준 연도(예: 2025 = 2025-01-01 기준).
  year      Int
  count     Int
  // 만원.
  median    Int
  min       Int
  max       Int
  // 구간 안 호별 전용면적 평균(㎡).
  avgArea   Float

  @@id([complexId, band])
  @@map("housing_complex_prices")
}
